# Transit Analytics Web App Configuration

# (Next.js Frontend) API endpoint URL
# Required for production. Defaults to http://localhost:8000 for local development.
# Set this to your deployed FastAPI backend URL when using Vercel.
# Example: https://transit-analytics-api.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8000

# (FastAPI Backend) Path to a pre-built demo database
# Optional. If not set, the demo database is built on first request.
# On deploy platforms, set this to avoid cold-start delays.
# Example: /data/demo.db
DEMO_DB=

# (FastAPI Backend) Server port
# Optional. Defaults to 8000.
PORT=8000
